# Copy to .env for production customization
WMS_APP_NAME=PocketWMS API
WMS_DATABASE_URL=sqlite:///./smart_wms.db
# Switch to PostgreSQL on Cloud: postgresql+psycopg://user:CHANGE_ME@host:5432/smart_wms
WMS_JWT_SECRET=CHANGE_ME_DEV_SECRET_KEY_FOR_LOCAL_ONLY
WMS_ACCESS_TOKEN_EXPIRE_MINUTES=720
WMS_DEMO_PASS=SAMPLE_Pass123!
